<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SSH client: network access is the first capability it needs. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reconnect tabs as soon as the network comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep the sessions that would be lost connected with the screen locked (ADR-0023). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The app installs its own verified updates (ADR-0025); the user grants it in the system settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: lets an update the app installed itself go through without asking again. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- ADR-0027: the canary copies the stable app's configuration (no secrets)
         through its provider. Only an app signed with the same key gets this
         permission; both apps define it, so the order they are installed in
         does not matter. -->
    <permission
        android:name="io.github.danielperezmartinez.titanssh.permission.READ_STABLE_CONFIG"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.danielperezmartinez.titanssh.permission.READ_STABLE_CONFIG" />
    <queries>
        <provider android:authorities="${stableConfigAuthority}" />
    </queries>

    <!-- No backup or device transfer: see res/xml/data_extraction_rules.xml. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Foreground service with no time limit while a tab needs its connection (ADR-0023). -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps interactive SSH terminal sessions connected while the screen is locked; a dropped session loses the remote shell and its running processes." />
        </service>
        <!-- Enabled only in the stable app, where its authority is the
             stableConfigAuthority the canary reads (ADR-0027). The canary's
             disabled copy has its own authority: two apps cannot share one. -->
        <provider
            android:name="io.github.danielperezmartinez.titanssh.config.StableConfigProvider"
            android:authorities="${applicationId}.stableconfig"
            android:enabled="${stableConfigProviderEnabled}"
            android:exported="true"
            android:permission="io.github.danielperezmartinez.titanssh.permission.READ_STABLE_CONFIG" />
        <meta-data
            android:name="io.github.danielperezmartinez.titanssh.STABLE_CONFIG_AUTHORITY"
            android:value="${stableConfigAuthority}" />
    </application>

</manifest>
