# Normalize line endings across platforms.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf

# The Gradle wrapper script must stay LF to run on Unix shells.
gradlew text eol=lf

# Binary assets — never touch line endings.
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.apk binary
*.aab binary
*.keystore binary
