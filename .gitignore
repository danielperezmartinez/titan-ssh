# Gradle
.gradle/
**/build/
.kotlin/

# Local machine config (SDK path, secrets) — never versioned
local.properties

# IDE
.idea/
*.iml
*.ipr
*.iws

# Android build outputs
*.apk
*.aab
captures/

# OS noise
.DS_Store
Thumbs.db

# Device screenshots dropped into the vault (may show real host/user; kept local)
docs/**/Screenshot_*.png

# Agent skills: .agents/ + skills-lock.json are versioned; .claude/skills/ holds
# per-machine Windows junctions (absolute paths) into .agents/skills, so it is
# recreated locally by the skills CLI instead of committed.
.claude/skills/
# Personal Claude Code settings (never shared)
.claude/settings.local.json
# Git worktrees that agent sessions create to work without touching the main tree
.claude/worktrees/

# Android release signing keys: never versioned (ADR-0011 §5)
*.jks
*.keystore

# Obsidian's per-machine state: window layout (rewritten on every use) and the
# community plugins each machine installs. The shared vault config (core
# plugins such as Bases, templates, links, appearance) stays versioned.
docs/.obsidian/workspace*.json
docs/.obsidian/community-plugins.json
docs/.obsidian/plugins/
